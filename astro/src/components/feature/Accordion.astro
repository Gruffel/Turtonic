---
const { title } = Astro.props;
---

<details class="accordion">
  <summary class="accordion-summary">{title}</summary>
  <div class="accordion-content">
    <slot />
  </div>
</details>

<style>
  .accordion {
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    margin-bottom: 1rem;
    background-color: #fff;
  }

  .accordion-summary {
    padding: 1rem;
    cursor: pointer;
    font-weight: 600;
    color: #333;
    background-color: #f9f9f9;
  }

  .accordion-content {
    padding: 1rem;
    color: #333;
  }
</style>
